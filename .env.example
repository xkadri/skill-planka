# Base URL of your Planka instance. When running as a docker-compose sidecar
# next to a service named "planka", use the internal service name/port:
#   PLANKA_BASE_URL=http://planka:1337
PLANKA_BASE_URL=http://localhost:1337

# Transport: "http" (default, for sidecar/remote use) or "stdio" (local dev)
TRANSPORT=http

# Port to listen on when TRANSPORT=http
PORT=3001

# --- API key ---
# In HTTP mode (the default), each MCP client supplies its OWN Planka API key
# per-request via the "Authorization: Bearer <key>" (or "X-Planka-Api-Key")
# header -- do NOT put a key here. Get a key from Planka -> User Settings ->
# API Keys, and configure it in your MCP client, not in this file.
#
# PLANKA_API_KEY is only read in stdio mode, where there's no per-request
# header channel and the server process is already scoped to one client:
# PLANKA_API_KEY=
